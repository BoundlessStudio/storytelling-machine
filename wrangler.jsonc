{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "story-computing-machine-guide",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-27",
  "routes": [
    { "pattern": "stories.rgbknights.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/"]
  },
  "ratelimits": [
    {
      "name": "GUIDE_LIMIT",
      "namespace_id": "1027",
      "simple": { "limit": 15, "period": 60 }
    }
  ],
  "vars": {
    "CHAT_MODEL": "openai/gpt-5-mini"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "invocation_logs": false }
  },
  "env": {
    "preview": {
      "routes": [],
      "workers_dev": true,
      "vars": {
        "CHAT_MODEL": "openai/gpt-5-mini"
      },
      "ratelimits": [
        {
          "name": "GUIDE_LIMIT",
          "namespace_id": "1028",
          "simple": { "limit": 15, "period": 60 }
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": { "invocation_logs": false }
      }
    }
  }
}
